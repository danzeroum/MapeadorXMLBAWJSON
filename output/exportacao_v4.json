{
  "$schema": "https://processveritas.org/schemas/v2plus/process-definition.json",
  "$id": "urn:pv:process:{processId}:2+",
  "schemaVersion": "2.1.0",
  
  "metadata": {
    "id": "urn:pv:process:{processId}:2+",
    "name": "{Process Name}",
    "description": "{Process Description}",
    "version": "2.1.0",
    "created": "{timestamp}",
    "updated": "{timestamp}",
    "tags": ["migrated-from-v1", "ai-ready"],
    "provenance": {
      "sourceVersion": "1.0",
      "migrationTimestamp": "{timestamp}",
      "migrationTool": "V1toV2+Migrator",
      "originalArtifactId": "{v1-artifact-id}"
    }
  },

  "processDefinition": {
    "variables": {
      "input": [
        {
          "name": "recondicionamento",
          "typeRef": "dt:recondicionamento@1",
          "cardinality": "one",
          "nullable": false,
          "description": "Dados do processo de recondicionamento"
        }
      ],
      "output": [
        {
          "name": "orcamentoFinal",
          "typeRef": "dt:orcamento@1", 
          "cardinality": "one",
          "nullable": false,
          "description": "Orçamento processado e validado"
        },
        {
          "name": "validationResult",
          "typeRef": "dt:validation@1",
          "cardinality": "one", 
          "nullable": false,
          "description": "Resultado das validações aplicadas"
        }
      ],
      "private": [
        {
          "name": "orcamentoAux",
          "typeRef": "dt:orcamento@1",
          "cardinality": "one",
          "nullable": true,
          "description": "Orçamento auxiliar para cálculos intermediários"
        },
        {
          "name": "validationErrors",
          "typeRef": "dt:errorList@1",
          "cardinality": "many",
          "nullable": true,
          "description": "Lista de erros de validação encontrados"
        }
      ]
    },

    "graph": {
      "nodes": [
        {
          "id": "n_start",
          "type": "StartEvent",
          "name": "Início do Processo",
          "lane": "operacoes"
        },
        {
          "id": "n_validar_formulario", 
          "type": "ScriptTask",
          "name": "Validar Formulário",
          "lane": "operacoes",
          "logicRef": "lg:validar_formulario"
        },
        {
          "id": "n_gateway_validacao",
          "type": "ExclusiveGateway", 
          "name": "Formulário Válido?",
          "lane": "operacoes"
        },
        {
          "id": "n_processar_orcamento",
          "type": "ScriptTask",
          "name": "Processar Orçamento",
          "lane": "operacoes", 
          "logicRef": "lg:processar_orcamento"
        },
        {
          "id": "n_corrigir_erros",
          "type": "UserTask",
          "name": "Corrigir Erros",
          "lane": "operacoes"
        },
        {
          "id": "n_end_success",
          "type": "EndEvent",
          "name": "Processo Concluído",
          "lane": "operacoes"
        },
        {
          "id": "n_end_error", 
          "type": "EndEvent",
          "name": "Processo com Erro",
          "lane": "operacoes"
        }
      ],
      
      "edges": [
        {
          "id": "e_start_to_validate",
          "source": "n_start",
          "target": "n_validar_formulario",
          "label": "Iniciar Validação"
        },
        {
          "id": "e_validate_to_gateway",
          "source": "n_validar_formulario", 
          "target": "n_gateway_validacao",
          "label": "Resultado Validação"
        },
        {
          "id": "e_gateway_to_process",
          "source": "n_gateway_validacao",
          "target": "n_processar_orcamento",
          "label": "Válido",
          "conditionRef": "cd:formulario_valido"
        },
        {
          "id": "e_gateway_to_correct",
          "source": "n_gateway_validacao",
          "target": "n_corrigir_erros", 
          "label": "Inválido",
          "conditionRef": "cd:formulario_invalido"
        },
        {
          "id": "e_process_to_end",
          "source": "n_processar_orcamento",
          "target": "n_end_success",
          "label": "Processamento Concluído"
        },
        {
          "id": "e_correct_to_error",
          "source": "n_corrigir_erros",
          "target": "n_end_error",
          "label": "Correção Necessária"
        }
      ],
      
      "lanes": [
        {
          "id": "operacoes",
          "name": "Operações",
          "participants": ["role:operador", "role:supervisor"]
        }
      ],
      
      "entryPoints": ["n_start"],
      "endPoints": ["n_end_success", "n_end_error"]
    },

    "conditions": [
      {
        "id": "cd:formulario_valido",
        "expr": "validationResult.errors.size() == 0",
        "exprLang": "cel",
        "description": "Formulário passou em todas as validações"
      },
      {
        "id": "cd:formulario_invalido", 
        "expr": "validationResult.errors.size() > 0",
        "exprLang": "cel",
        "description": "Formulário contém erros de validação"
      },
      {
        "id": "cd:orcamento_valido",
        "expr": "orcamentoAux.valor > 0 && orcamentoAux.status == 'APROVADO'",
        "exprLang": "cel",
        "description": "Orçamento tem valor positivo e status aprovado"
      }
    ],

    "mappings": {
      "exprLang": "cel", 
      "inputs": [
        {
          "target": "recondicionamento",
          "expr": "input.recondicionamento",
          "description": "Mapeamento direto dos dados de entrada"
        }
      ],
      "outputs": [
        {
          "source": "orcamentoAux",
          "target": "orcamentoFinal", 
          "expr": "orcamentoAux",
          "description": "Orçamento auxiliar vira o orçamento final"
        },
        {
          "source": "validationErrors",
          "target": "validationResult",
          "expr": "{errors: validationErrors, isValid: size(validationErrors) == 0}",
          "description": "Compila resultado das validações"
        }
      ],
      "transformations": [
        {
          "id": "tr:calcular_valor_total",
          "expr": "orcamento.valorBase + sum(orcamento.servicosAdicionais[*].valor)",
          "description": "Calcula valor total do orçamento"
        },
        {
          "id": "tr:normalizar_responsavel",
          "expr": "trim(upper(responsavel.nome))",
          "description": "Normaliza nome do responsável"
        }
      ]
    },

    "logic": {
      "items": [
        {
          "id": "lg:validar_formulario",
          "language": "javascript",
          "inputs": ["recondicionamento"],
          "outputs": ["validationErrors"],
          "code": "// Script extraído da V1\n// Original: inline no step 'Validar Formulario'\nvar errors = [];\n\nif (!recondicionamento.transporteEntrega.responsavelTransporte || \n    recondicionamento.transporteEntrega.responsavelTransporte.value === '' ||\n    recondicionamento.transporteEntrega.responsavelTransporte.value === 'SC_NULL') {\n    errors.push({\n        field: 'recondicionamento.transporteEntrega.responsavelTransporte',\n        message: 'Campo Obrigatório'\n    });\n}\n\nreturn { validationErrors: errors };",
          "metadata": {
            "extractedFrom": "step:2025.f6c28dac-b2a9-40f5-82c7-0dde7c80efb2",
            "originalType": "Script",
            "complexity": "medium"
          }
        },
        {
          "id": "lg:processar_orcamento", 
          "language": "javascript",
          "inputs": ["recondicionamento", "orcamentoAux"],
          "outputs": ["orcamentoAux"],
          "code": "// Script de processamento do orçamento\n// Lógica de cálculo e validação\nif (orcamentoAux.naoOrcamentar) {\n    orcamentoAux.valor = 0;\n    orcamentoAux.status = 'NAO_ORCAMENTADO';\n} else {\n    // Cálculos específicos do orçamento\n    orcamentoAux.valor = calculateBudgetValue(recondicionamento);\n    orcamentoAux.status = 'CALCULADO';\n}\n\nreturn { orcamentoAux: orcamentoAux };",
          "metadata": {
            "extractedFrom": "step:multiple_scripts",
            "originalType": "Script", 
            "complexity": "high"
          }
        }
      ],

      "validations": [
        {
          "id": "vl:responsavel_transporte_obrigatorio",
          "when": "step == 'Validar Formulário'",
          "rule": "isEmpty(recondicionamento.transporteEntrega.responsavelTransporte.value)",
          "severity": "error",
          "messageKey": "campo.obrigatorio",
          "description": "Responsável pelo transporte é obrigatório"
        },
        {
          "id": "vl:matricula_viatura_formato",
          "when": "step == 'Validar Formulário'", 
          "rule": "!matches(recondicionamento.viatura.matricula, '^[A-Z0-9]{6,12}$')",
          "severity": "error",
          "messageKey": "matricula.formato.invalido",
          "description": "Matrícula deve ter entre 6 e 12 caracteres alfanuméricos"
        },
        {
          "id": "vl:orcamento_valor_positivo",
          "when": "step == 'Processar Orçamento'",
          "rule": "orcamentoAux.valor <= 0",
          "severity": "error", 
          "messageKey": "orcamento.valor.positivo",
          "description": "Valor do orçamento deve ser positivo"
        }
      ]
    }
  },

  "dataTypes": [
    {
      "id": "dt:recondicionamento@1",
      "name": "Recondicionamento",
      "version": "1.0.0",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "viatura": {
            "type": "object",
            "properties": {
              "matricula": {
                "type": "string",
                "pattern": "^[A-Z0-9]{6,12}$",
                "description": "Matrícula da viatura"
              }
            },
            "required": ["matricula"]
          },
          "transporteEntrega": {
            "type": "object", 
            "properties": {
              "responsavelTransporte": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["value"]
              }
            },
            "required": ["responsavelTransporte"]
          },
          "instalacao": {
            "type": "object",
            "properties": {
              "marca": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  }
                }
              },
              "plataforma": {
                "type": "object", 
                "properties": {
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": ["viatura", "transporteEntrega"]
      }
    },
    {
      "id": "dt:orcamento@1",
      "name": "Orçamento",
      "version": "1.0.0",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "valor": {
            "type": "number",
            "minimum": 0,
            "unit": "BRL",
            "description": "Valor do orçamento em reais"
          },
          "diasUteis": {
            "type": "integer",
            "minimum": 0,
            "description": "Número de dias úteis para execução"
          },
          "status": {
            "type": "string",
            "enum": ["PENDENTE", "CALCULADO", "APROVADO", "REJEITADO", "NAO_ORCAMENTADO"]
          },
          "naoOrcamentar": {
            "type": "boolean",
            "default": false
          },
          "servicosAdicionais": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/servico"
            }
          }
        },
        "required": ["valor", "status"],
        "$defs": {
          "servico": {
            "type": "object",
            "properties": {
              "nome": {"type": "string"},
              "valor": {"type": "number", "minimum": 0}
            },
            "required": ["nome", "valor"]
          }
        }
      }
    },
    {
      "id": "dt:validation@1",
      "name": "ValidationResult",
      "version": "1.0.0", 
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/validationError"
            }
          },
          "isValid": {
            "type": "boolean"
          }
        },
        "required": ["errors", "isValid"],
        "$defs": {
          "validationError": {
            "type": "object",
            "properties": {
              "field": {"type": "string"},
              "message": {"type": "string"},
              "severity": {"type": "string", "enum": ["error", "warning", "info"]}
            },
            "required": ["field", "message"]
          }
        }
      }
    },
    {
      "id": "dt:errorList@1",
      "name": "ErrorList", 
      "version": "1.0.0",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"},
            "field": {"type": "string"}
          },
          "required": ["code", "message"]
        }
      }
    }
  ],

  "ui": {
    "hints": {
      "labels": [
        {
          "nodeId": "n_validar_formulario",
          "label": "Validação inicial dos dados"
        },
        {
          "nodeId": "n_processar_orcamento",
          "label": "Cálculo do orçamento final"
        }
      ],
      "breadcrumbs": [
        "Início",
        "Validação", 
        "Processamento",
        "Finalização"
      ],
      "layout": {
        "orientation": "horizontal",
        "nodeSpacing": 150,
        "laneHeight": 200
      }
    },
    
    "i18n": {
      "defaultLocale": "pt-BR",
      "bundles": {
        "pt-BR": {
          "campo.obrigatorio": "Campo Obrigatório",
          "matricula.formato.invalido": "Formato de matrícula inválido. Use entre 6 e 12 caracteres alfanuméricos",
          "orcamento.valor.positivo": "O valor do orçamento deve ser positivo",
          "processo.concluido": "Processo concluído com sucesso",
          "erro.validacao": "Erro de validação encontrado"
        },
        "en-US": {
          "campo.obrigatorio": "Required Field",
          "matricula.formato.invalido": "Invalid license plate format. Use 6 to 12 alphanumeric characters",
          "orcamento.valor.positivo": "Budget value must be positive",
          "processo.concluido": "Process completed successfully", 
          "erro.validacao": "Validation error found"
        }
      }
    }
  },

  "businessContext": {
    "domain": "urn:pv:domain:recondicionamento:2",
    "subDomain": "orçamentação",
    "stakeholders": [
      {
        "role": "operador",
        "name": "Operador de Recondicionamento",
        "responsibilities": ["validação", "entrada_dados"]
      },
      {
        "role": "supervisor", 
        "name": "Supervisor de Operações",
        "responsibilities": ["aprovação", "correção_erros"]
      }
    ],
    "compliance": [
      {
        "standard": "ISO-9001",
        "requirement": "Rastreabilidade de processos",
        "coverage": "full"
      }
    ]
  },

  "quality": {
    "lintRules": {
      "reservedNamesDenied": ["Number", "Date", "Object", "object", "Array", "String"],
      "variableCase": "camelCase", 
      "nodeNamingPattern": "^[A-Z][a-zA-Z0-9\\s]+$",
      "maxScriptComplexity": 10,
      "requiredFields": ["typeRef", "name", "cardinality"]
    },
    "metrics": {
      "complexity": {
        "cyclomatic": 3,
        "cognitive": 2
      },
      "maintainability": {
        "score": 85,
        "factors": ["externalized_scripts", "declarative_validations", "typed_variables"]
      }
    }
  },

  "security": {
    "policies": [
      {
        "id": "sp:no_inline_scripts",
        "rule": "Scripts must be externalized",
        "enforcement": "blocking"
      },
      {
        "id": "sp:typed_variables",
        "rule": "All variables must have typeRef",
        "enforcement": "warning"
      }
    ],
    "dataClassification": {
      "recondicionamento": "internal",
      "orcamento": "confidential"
    }
  },

  "analytics": {
    "kpis": [
      {
        "name": "validation_success_rate",
        "description": "Taxa de sucesso das validações",
        "calculation": "valid_submissions / total_submissions"
      },
      {
        "name": "average_processing_time",
        "description": "Tempo médio de processamento",
        "unit": "seconds"
      }
    ]
  }
}