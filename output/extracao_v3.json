    "logic": {
      "items": [
        {
          "id": "lg:validar_form_reparacao",
          "language": "twjs",
          "inputs": [
            "recondicionamento"
          ],
          "outputs": [
            "validate"
          ],
          "code": "tw.local.validate = new tw.object.CoachValidation();\nif (tw.local.recondicionamento.dataInicioReparacaoAux.date == undefined ||\n    tw.local.recondicionamento.dataInicioReparacaoAux.date == null) {\n  tw.system.addCoachValidationError(\n    tw.local.validate,\n    \"tw.local.recondicionamento.dataInicioReparacaoAux.date\",\n    \"Campo Obrigatório.\"\n  );\n}\n"
        },
        {
          "id": "lg:eurotax_script",
          "language": "twjs",
          "inputs": [
            "ioViatura"
          ],
          "outputs": [
            "ioViatura"
          ],
          "code": "if (tw.local.ioViatura.eurotaxData.brand.name != undefined &&\n    tw.local.ioViatura.eurotaxData.brand.name != null &&\n    tw.local.ioViatura.eurotaxData.brand.name != \"\"){\n  if (tw.local.ioViatura.eurotaxData.brand.name != tw.resource.GRCR.selectDefaultLbl){\n    tw.local.ioViatura.marca = tw.local.ioViatura.eurotaxData.brand.name;\n  } else { tw.local.ioViatura.marca = null; }\n}\nif (tw.local.ioViatura.eurotaxData.model.name != undefined &&\n    tw.local.ioViatura.eurotaxData.model.name != null &&\n    tw.local.ioViatura.eurotaxData.model.name != \"\"){\n  if (tw.local.ioViatura.eurotaxData.model.name != tw.resource.GRCR.selectDefaultLbl){\n    tw.local.ioViatura.modelo = tw.local.ioViatura.eurotaxData.model.name;\n  } else { tw.local.ioViatura.modelo = null; }\n}\n"
        }
      ],
      "validations": [
        {
          "id": "vl:data_inicio_obrigatoria",
          "when": "nodeId == 'n_validar_form'",
          "rule": "isNull(recondicionamento.dataInicioReparacaoAux.date)",
          "severity": "error",
          "messageKey": "campo.obrigatorio"
        }
      ]
    }
